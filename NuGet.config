<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Локальный/корпоративный фид (nexus.kontur.host) отдаёт 403 без VPN и ломает restore.
    clear отвязывает решение от глобальных настроек машины: пакеты тянутся с nuget.org.
    Если нужен корпоративный фид — добавьте его здесь вместе с credentials в NuGet.config уровня пользователя.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
