{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "Polling": {
    "IntervalMinutes": 10,
    "MaxConcurrency": 4,
    "MaxRequestsPerSecond": 2,
    "BoardTimeoutSeconds": 30,
    "DryRun": true
  },

  "Delivery": {
    "VacanciesPerMessage": 8,
    "DelayBetweenMessagesSeconds": 3,
    "BatchSize": 50,
    "DispatchIntervalSeconds": 5,
    "MaxAttempts": 6,
    "DailyMessageCap": 200
  },

  "Storage": {
    "DatabasePath": "jobs_pulse.db"
  },

  "Sources": {
    "Greenhouse": {
      "BaseUrl": "https://boards-api.greenhouse.io/v1/boards/",
      "IncludeContentOnPoll": false,
      "MaxSlugGuesses": 8
    }
  },

  "Telegram": {
    "BotToken": "",
    "DefaultChatId": "",
    "AdminChatIds": [],
    "EnableCommands": true
  }
}
