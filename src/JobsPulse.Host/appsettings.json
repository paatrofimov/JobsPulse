{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Polling": {
    "IntervalMinutes": 10,
    "MaxConcurrency": 4,
    "MaxRequestsPerSecond": 2,
    "BoardTimeoutSeconds": 30,
    "DryRun": true
  },
  "RegistryPolling": {
    "Enabled": true,
    "CycleIntervalMinutes": 15,
