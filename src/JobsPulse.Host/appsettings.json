{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "WatchlistPolling": {
    "PollingIntervalMinutes": 10,
    "MaxConcurrentEntries": 12,
    "SingleEntryProcessTimeoutSeconds": 180,
    "DryRun": false
  },
  "RegistryPolling": {
    "Enabled": true,
    "CycleIntervalMinutes": 15,
    "StartDelayMinutes": 5,
    "BoardsPerCycle": 50,
    "MaxConcurrentBoards": 6,
    "DelayBetweenBoardsMs": 500,
    "SingleEntryProcessTimeoutSeconds": 180,
    "MaxRegistryBoards": 20000,
    "AutoAdd": true,
    "MaxAutoAddedBoardsPerCycle": 5,
    "DryRun": false
  },
  "Digest": {
    "PeriodDays": 3,
    "MaxPeriodDays": 365,
    "RunReports": true
  },
  "Delivery": {
    "VacanciesPerMessage": 8,
    "DelayBetweenMessagesSeconds": 3,
    "OutboxBatchSize": 500,
    "DispatchOutboxIntervalSeconds": 5,
    "MaxAttemptsBeforeDeadLetter": 6,
    "FreshVacancyDays": 3,
    "GroupChangesWithinMinutes": 15,
    "WindowSettleSeconds": 30,
    "TraversalRunStaleSeconds": 180,
    "ActivityWindowDays": 90,
    "DeliveredRetentionHours": 24,
    "CleanupIntervalMinutes": 60
  },
  "Discovery": {
    "Enabled": true,
    "Mode": "Parquet",
    "IndexBaseUrl": "https://index.commoncrawl.org/",
    "BootstrapYears": 3,
    "StartDelayMinutes": 2,
    "RunIntervalHours": 24,
    "CheckpointIntervalMinutes": 5,
    "MaxPagesPerCollection": 0,
    "PageSize": 5,
    "MaxNewTokensPerRun": 5000,
    "ValidationConcurrency": 4,
    "UpsertBatchSize": 200,
    "IndexRetries": 3,
    "IndexRetryDelaySeconds": 10,
    "Parquet": {
      "DataBaseUrl": "https://data.commoncrawl.org/",
      "Subset": "warc",
      "FilesPerQuery": 25,
      "MaxFilesPerCollection": 0,
      "UrlPathSegments": 3,
      "Retries": 3,
      "RetryDelaySeconds": 15,
      "MaxBatchFailuresPerCollection": 3,
      "PauseBetweenBatchesMsec": 500,
      "FallbackToHttp": true,
      "QueryTimeoutSeconds": 900,
      "Threads": 4,
      "MemoryLimitMb": 2048
    }
  },
  "Sources": {
    "Greenhouse": {
      "BaseUrl": "https://boards-api.greenhouse.io/v1/boards/",
      "IncludeContentOnPoll": false,
      "MaxSlugGuesses": 8
    },
    "Lever": {
      "Regions": [ "global", "eu" ],
      "IncludeContentOnPoll": false,
      "PageSize": 100,
      "MaxPages": 50,
      "ProbePageSize": 100,
      "MaxSlugGuesses": 8,
      "Location": [],
      "Team": [],
      "Department": [],
      "Commitment": [],
      "Level": []
    },
    "SmartRecruiters": {
      "BaseUrl": "https://api.smartrecruiters.com/v1/companies/",
      "IncludeContentOnPoll": false,
      "MaxDetailsPerPoll": 100,
      "DetailConcurrency": 4,
      "PageSize": 100,
      "MaxPages": 100,
      "ProbePageSize": 1,
      "MaxSlugGuesses": 8,
      "Query": null,
      "Country": null,
      "Region": null,
      "City": null,
      "Department": null,
      "Language": null
    },
    "Ashby": {
      "BaseUrl": "https://api.ashbyhq.com/posting-api/job-board/",
      "IncludeUnlisted": false,
      "MaxSlugGuesses": 8
    },
    "Workday": {
      "IncludeContentOnPoll": false,
      "MaxDetailsPerPoll": 100,
      "DetailConcurrency": 4,
      "PageSize": 20,
      "MaxPages": 250,
      "RequestTimeoutSeconds": 30
    },
    "SuccessFactors": {
      "IncludeContentOnPoll": false,
      "FeedPath": "jobfeed.xml",
      "MaxFeedBytes": 50331648,
      "EnableHtmlFallback": true,
      "HtmlPageSize": 25,
      "MaxPages": 400,
      "RequestTimeoutSeconds": 120,
      "EnableCareersPageLookup": true,
      "MaxCareersPageHints": 4,
      "CareerSubdomains": [
        "jobs",
        "careers",
        "career",
        "karriere"
      ]
    }
  },
  "Telegram": {
    "BotToken": "",
    "DefaultChatId": "",
    "AdminUsernames": [ "patrofimov" ],
    "AdminChatIds": [],
    "AllowedUserIds": [],
    "EnableCommands": true
  },
  "TelegramWebhook": {
    "PublicUrl": "",
    "Path": "/telegram",
    "SecretToken": ""
  }
