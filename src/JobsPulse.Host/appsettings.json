{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Polling": {
    "IntervalMinutes": 10,
    "MaxConcurrency": 4,
    "MaxRequestsPerSecond": 2,
    "BoardTimeoutSeconds": 30,
    "DryRun": true
  },
  "RegistryPolling": {
    "Enabled": true,
    "CycleIntervalMinutes": 15,
    "StartDelayMinutes": 5,
    "BoardsPerCycle": 50,
    "MaxConcurrentBoards": 2,
    "DelayBetweenBoardsMs": 500,
    "SingleEntryProcessTimeoutSeconds": 30,
    "MaxRegistryBoards": 20000,
    "DryRun": false
  },
  "Delivery": {
    "VacanciesPerMessage": 8,
    "DelayBetweenMessagesSeconds": 3,
    "BatchSize": 50,
    "DispatchIntervalSeconds": 5,
    "MaxAttempts": 6,
    "DailyMessageCap": 200,
    "FreshVacancyDays": 3,
    "DeliveredRetentionHours": 24,
    "CleanupIntervalMinutes": 60
  },
  "Discovery": {
    "Enabled": true,
    "Mode": "Parquet",
    "IndexBaseUrl": "https://index.commoncrawl.org/",
    "BootstrapYears": 3,
    "StartDelayMinutes": 2,
    "RunIntervalHours": 24,
    "MaxPagesPerCollection": 0,
    "PageSize": 5,
    "MaxNewTokensPerRun": 5000,
    "ValidationConcurrency": 4,
    "UpsertBatchSize": 200,
    "IndexRetries": 3,
    "IndexRetryDelaySeconds": 10,
    "Parquet": {
      "DataBaseUrl": "https://data.commoncrawl.org/",
      "Subset": "warc",
      "FilesPerQuery": 25,
      "MaxFilesPerCollection": 0,
      "UrlPathSegments": 3,
      "Retries": 3,
      "RetryDelaySeconds": 15,
      "MaxBatchFailuresPerCollection": 3,
      "PauseBetweenBatchesMsec": 500,
      "FallbackToHttp": true,
      "QueryTimeoutSeconds": 900,
      "Threads": 4,
      "MemoryLimitMb": 2048
    }
  },
  "Sources": {
    "Greenhouse": {
      "BaseUrl": "https://boards-api.greenhouse.io/v1/boards/",
      "IncludeContentOnPoll": false,
      "MaxSlugGuesses": 8
    },
    "Lever": {
      "Regions": [ "global", "eu" ],
      "IncludeContentOnPoll": false,
      "PageSize": 100,
      "MaxPages": 50,
      "ProbePageSize": 100,
      "MaxSlugGuesses": 8,
      "Location": [],
      "Team": [],
      "Department": [],
      "Commitment": [],
      "Level": []
    },
    "SmartRecruiters": {
      "BaseUrl": "https://api.smartrecruiters.com/v1/companies/",
      "IncludeContentOnPoll": false,
      "PageSize": 100,
      "MaxPages": 50,
      "ProbePageSize": 1,
      "MaxSlugGuesses": 8,
      "MaxDescriptionRequests": 100,
      "Query": null,
      "Country": null,
      "Region": null,
      "City": null,
      "Department": null,
      "Language": null
    },
    "Ashby": {
      "BaseUrl": "https://api.ashbyhq.com/posting-api/job-board/",
      "IncludeUnlisted": false,
      "MaxSlugGuesses": 8
    },
    "Workday": {
      "IncludeContentOnPoll": false,
      "PageSize": 20,
      "MaxPages": 250,
      "MaxDescriptionRequests": 100,
      "RequestTimeoutSeconds": 30
    }
  },
  "Telegram": {
    "BotToken": "",
    "DefaultChatId": "",
    "AdminChatIds": [],
    "EnableCommands": true
  }
}
