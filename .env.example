ConnectionStrings__Postgres=Host=<host>;Database=jobspulse;Username=<user>;Password=<password>;SSL Mode=Require
Telegram__BotToken=<token>
# Optional: lets the bot start the polling workflow right after a company is added.
GitHubDispatch__Token=<fine-grained PAT with Actions: read and write>
# Webhook role only: the secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token (letters, digits, _ and -).
TelegramWebhook__SecretToken=<random string>
